# Senvori — environment template (§8).
# Copy to `.env.local` for development. NEVER commit real secrets: staging and
# production values live in the provider's secret vault, not in the repo. See
# docs/ENVIRONMENT.md for the full variable reference and per-environment matrix.

# ---- API: core ----
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://senvori:senvori@localhost:5432/senvori
REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=change-me-32-chars-minimum-secret
BETTER_AUTH_URL=http://localhost:3001
DASHBOARD_URL=http://localhost:3000

# ---- API: production readiness (§9) ----
# pino log level: fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=info
# Enable ONLY behind a trusted proxy/LB so X-Forwarded-* (client IP) is honoured.
TRUST_PROXY=false
# Per-IP rate limit (health probes are always exempt).
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
# Drain grace before close() on SIGTERM/SIGINT (ms) — let the LB stop routing first.
SHUTDOWN_GRACE_MS=5000

# ---- Catalog media storage (§4) ----
# local = filesystem driver (dev/test); r2 = Cloudflare R2 (production)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage
CATALOG_MAX_UPLOAD_BYTES=524288000
CATALOG_UPLOAD_TTL_SECONDS=3600
CATALOG_DOWNLOAD_TTL_SECONDS=300

# Cloudflare R2 (only when STORAGE_DRIVER=r2) — private bucket, never commit real keys.
# Create an S3 API token in the Cloudflare dashboard; the endpoint is
# https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto

# ---- Dashboard ----
NEXT_PUBLIC_API_URL=http://localhost:3001
